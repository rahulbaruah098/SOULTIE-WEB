# =========================================================
# SOULTIE - EXAMPLE ENVIRONMENT CONFIGURATION
# Never commit real production secrets.
# =========================================================

# Application
APP_ENV=development
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

# API
API_VERSION=v1
FRONTEND_ORIGIN=http://localhost:5173
MAX_CONTENT_LENGTH=20971520
LOG_LEVEL=DEBUG

# MongoDB
MONGO_URI=mongodb://localhost:27017/soultie
# Redis
REDIS_URL=redis://localhost:6379/0

# Development OTP
# NEVER enable this in production.
EXPOSE_DEV_OTP=true

# JWT / Mobile Authentication
JWT_SECRET_KEY=replace-with-a-separate-long-random-jwt-secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Google Authentication
GOOGLE_CLIENT_ID=

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SOULTIE
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

# Email OTP
EMAIL_OTP_KEY_PREFIX=xuoroni:email-otp

# Development only. Leave empty in production.
DEV_EMAIL_OTP_CODE=654321

# Existing Admin Seed
ADMIN_EMAIL=admin@xuoroni.local
ADMIN_PASSWORD=ChangeMe123!

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Socket.IO
SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/3

# Object Storage - configure later
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=

# AWS credentials should NOT normally be stored here in production.
# Production will use IAM / Secrets Manager.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Database initialization
AUTO_ENSURE_INDEXES=true

JWT_ISSUER=xuoroni-backend
JWT_AUDIENCE=xuoroni-mobile

# Mobile OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_WINDOW_SECONDS=3600
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_KEY_PREFIX=xuoroni:otp
OTP_HASH_SECRET=replace-with-a-long-random-secret
DEV_OTP_CODE=123456
